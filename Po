local function PlayRPS(playerChoice)
    local choices = {"Rock", "Scissors", "Paper"}
    local aiChoice = choices[math.random(1, #choices)]
    
    local iconMap = {Rock = "✊ ค้อน", Scissors = "✌️ กรรไกร", Paper = "🖐️ กระดาษ"}
    
    local resultText = ""
    if playerChoice == aiChoice then
        resultText = "เสมอ! (AI ออก " .. iconMap[aiChoice] .. ")"
        RPSStatus.TextColor3 = Color3.fromRGB(255, 255, 100)
    elseif (playerChoice == "Rock" and aiChoice == "Scissors") or
           (playerChoice == "Scissors" and aiChoice == "Paper") or
           (playerChoice == "Paper" and aiChoice == "Rock") then
        resultText = "คุณชนะ! 🎉 (AI ออก " .. iconMap[aiChoice] .. ")"
        Settings.PlayerScore = Settings.PlayerScore + 1
        RPSStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        resultText = "คุณแพ้! ❌ (AI ออก " .. iconMap[aiChoice] .. ")"
        Settings.AIScore = Settings.AIScore + 1
        RPSStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
    
    RPSStatus.Text = resultText
    ScoreLabel.Text = "คะแนน: คุณ " .. Settings.PlayerScore .. " - " .. Settings.AIScore .. " AI"
end

